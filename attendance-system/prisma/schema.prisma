generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id             String        @id @default(cuid())
  employeeCode   String        @unique
  name           String
  // department: نسخة نصية متزامنة (denormalized) من departmentRef.name.
  // المصدر الموثوق هو departmentId/departmentRef؛ ويبقى هذا الحقل متطابقاً
  // معه دائماً لأن كل عمليات الكتابة تمرّ عبر resolveEmployeeDepartment.
  // نحتفظ به للأداء (قراءة بدون JOIN) ولدعم السجلات القديمة (departmentId = null).
  department     String
  departmentId   String?
  departmentRef  Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position       String
  phone          String?
  referencePhotoUrl String?
  hasReferencePhoto Boolean       @default(false)
  shiftId        String?
  shift          WorkSchedule? @relation(fields: [shiftId], references: [id])
  customEndTime  String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  attendances    Attendance[]

  @@index([isActive])
  @@index([shiftId])
  @@index([department])
  @@index([departmentId])
  @@index([name])
  @@index([isActive, shiftId])
  @@index([isActive, hasReferencePhoto])
}

model Attendance {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime  @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     Status    @default(PRESENT)
  // طريقة التسجيل لكل حدث (صورة بمراجعة، يدوي، أو سجلات قديمة بالوجه).
  checkInMethod          Method?
  checkOutMethod         Method?
  checkInPhotoUrl        String?
  checkOutPhotoUrl       String?
  checkInPhotoAttempts   Int       @default(0)
  checkOutPhotoAttempts  Int       @default(0)
  checkInShiftId         String?
  checkOutShiftId        String?
  checkInVerificationStatus  VerificationStatus?
  checkOutVerificationStatus VerificationStatus?
  checkInRejectionReason     String?
  checkOutRejectionReason    String?
  checkInReviewedAt          DateTime?
  checkOutReviewedAt         DateTime?
  checkInReviewedById        String?
  checkOutReviewedById       String?
  checkInReviewedByName      String?
  checkOutReviewedByName     String?
  overtime   Int?
  notes      String?
  createdAt  DateTime  @default(now())

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
  @@index([date, status])
  @@index([date, checkIn(sort: Desc)])
  @@index([date, employeeId])
  @@index([checkInVerificationStatus])
  @@index([checkOutVerificationStatus])
}

model WorkSchedule {
  id                String     @id @default(cuid())
  name              String
  startTime         String
  endTime           String
  lateAfter         Int        @default(0)
  earlyLeaveBefore  Int        @default(0)
  isDefault         Boolean    @default(false)
  employees         Employee[]
  createdAt         DateTime   @default(now())

  @@index([isDefault])
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model SystemUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(MANAGER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Alert {
  id           String    @id @default(cuid())
  type         AlertType
  employeeId   String
  employeeName String
  message      String
  isRead       Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([isRead, createdAt(sort: Desc)])
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

enum Status {
  PRESENT
  ABSENT
  LATE
  EARLY_LEAVE
}

enum Method {
  FACE
  EMERGENCY_CODE
  MANUAL
  PHOTO
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  MANAGER
  INQUIRY_CLERK
}

enum AlertType {
  LATE
  ABSENT
  OVERTIME
}
