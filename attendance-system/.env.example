# Supabase — مطلوب للمصادقة وتخزين صور الحضور
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# مفتاح السيرفر — اختياري إذا استخدمت مفاتيح S3 أدناه
SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-jwt-or-sb-secret

# مفاتيح S3 لتخزين الصور (مطلوبة لمشاريع Supabase بتوقيع JWT الجديد)
# أنشئها من: Supabase → Storage → S3 Access Keys
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=eu-central-1

# قاعدة البيانات — Supabase Postgres
# DATABASE_URL: pooler (port 6543) + ?pgbouncer=true — للتطبيق
# DIRECT_URL: session pooler (port 5432) — للـ migrations و Prisma CLI
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# الحضور والانصراف — مفتاح سري (قيمة عشوائية 64 حرف hex)
KIOSK_API_KEY=change-me-to-a-long-random-secret

# تنظيف صور الحضور تلقائياً (Vercel Cron يومياً) — مطلوب في الإنتاج
CRON_SECRET=change-me-to-another-long-random-secret

# جلسة الكشك تُمنح لمن يفتح /kiosk (مناسب للتابلت الداخلي).
# لا تنشر رابط /kiosk على الإنترنت العام بدون حماية إضافية (VPN/سماح IP).

# اختياري — rate limit موزع (Upstash Redis)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# مطلوب عند auth:setup-production / auth:create-sql (ممنوع Admin@123456)
# AUTH_SETUP_PASSWORD=StrongPasswordHere!

# قائمة تحقق Vercel Production:
# DIRECT_URL · CRON_SECRET · KIOSK_API_KEY · SUPABASE_S3_* · (لا تضع AUTH_SETUP_PASSWORD على Runtime إلا للسكربتات)
